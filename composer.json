{
  "name": "placetopay/placetopay-sdk",
  "description": "PHP SDK to connect with the PlacetoPay Checkout service",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Diego Calle",
      "email": "dnetix@gmail.com"
    }
  ],
  "require": {
    "php": "^8.1",
    "ext-json": "*",
    "guzzlehttp/guzzle": "^7.15.2 || ^8.0.1",
    "psr/log": "^1.1|^2.0|^3.0"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.64",
    "phpunit/phpunit": "^10.5.62 || ^11.5.50"
  },
  "autoload": {
    "psr-4": {
      "PlacetoPay\\PlacetoPaySdk\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "PlacetoPay\\PlacetoPaySdk\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "testdox": "XDEBUG_MODE=coverage vendor/bin/phpunit --testdox --coverage-clover coverage.xml",
    "php-cs-fixer": "vendor/bin/php-cs-fixer fix --stop-on-violation --using-cache=no"
  }
}
